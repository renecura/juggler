local state = require("core.state")

local ALTO = 800
local HAND = 240
local END_DELAY = 1.2

local function other_hand(hand)
	return hand == "left" and "right" or "left"
end

local function hand_side(hand)
	return hand == "left" and -1 or 1
end

local function hand_table(self, hand)
	return hand == "left" and self.hand_left or self.hand_right
end

local function create_balls(self)
	self.hand_left = {}
	self.hand_right = {}

	local side = "right"

	for i = 1, state.balls do
		local pos = vmath.vector3(HAND * hand_side(side), 0, 0) + 
		vmath.rotate(vmath.quat_rotation_z(i*1), vmath.vector3(20,0,0))

		local id = factory.create("#ball_factory",pos)

		table.insert(hand_table(self, side), id)
		side = other_hand(side)
	end
end


local function level_start(self)
	self.score = 0
	self.win = false
	self.lose = false
	create_balls(self)
end

local function level_finish(self, won)
	if self.ended then return end
	self.ended = true
	
	state.score = state.score + self.score

	-- TODO: Disable input.
	-- TODO: Disable anillo.
	-- TODO: Disable points.
	msg.post("main:/manager#manager", "level_ended", {won = won})
end

local function level_win(self)
	if self.win then return end
	self.win = true
	
	msg.post("#HUD", "powerup")
	sound.play("/scene#sound_victory")
	
	-- level_finish(self, true)
end

local function level_lose(self)
	if self.lose then return end
	self.lose = true
	
	sound.play("/scene#sound_gameover")
	timer.delay(END_DELAY, false, function ()
		level_finish(self, false)
	end)
end


function init(self)
	self.ended = false
	level_start(self)
end



function on_message(self, message_id, message)

	if self.ended or self.lose then return end
	
	if message_id == hash("powerup") then
		level_finish(self, true)
	end
	
	if message_id == hash("score") then
		self.score = self.score + message.points * state.multi

		msg.post("#HUD", "set_progress", {
			score = self.score,
			target = state.score_target
		})

		if self.score >= state.score_target then
			-- end_level()
			level_win(self)
		end
	end
	
	if message_id == hash("landed") then
		if table.maxn(hand_table(self, message.target)) > 0 then
			level_lose(self)
		end
		
		table.insert(hand_table(self, message.target), message.ball)
		sprite.play_flipbook("/hands#"..message.target, hash("red_hand_closed"))			
	end
	
	if message_id == hash("fire") then
		local ball = table.remove(hand_table(self, message.side))
		if not ball then return end

		if table.maxn(hand_table(self, message.side)) == 0 then
			sprite.play_flipbook("/hands#"..message.side, hash("red_hand_open"))			
		end
		
		msg.post(ball, "fire", { 
			alto = ALTO,
			hand = HAND * hand_side(other_hand(message.side)),
			speed = state.speed,
			target = other_hand(message.side)
			})
	end
end