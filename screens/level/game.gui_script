local druid = require("druid.druid")

local FULL_WIDTH = 500

local function set_progress(self, p)       -- p entre 0 y 1
	p = math.max(0, math.min(1, p))
	self.progress:to(p)

	gui.set_scale(self.score, vmath.vector3(1.2))
	gui.animate(self.score, "scale", vmath.vector3(1), gui.EASING_OUTBACK, 0.3)
end

local function fire(self, side)
	msg.post("/scene", "fire", { side = side })
end

local function on_powerup(self)
	msg.post("/scene", "powerup")
end

function init(self)
	-- msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)
	
	self.left  = self.druid:new_button("left_btn", function() fire(self, "left") end )
	self.right = self.druid:new_button("right_btn", function() fire(self, "right") end)

	self.powerup_btn = self.druid:new_button("powerup_btn", on_powerup)
	self.powerup_node = gui.get_node("powerup_btn")
	gui.set_enabled(self.powerup_node, false)
	
	self.progress = self.druid:new_progress("progress","x",0)
	
	self.score = gui.get_node("score")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_progress") then
		set_progress(self, message.score / message.target)
		gui.set_text(self.score, message.score)
	end

	if message_id == hash("powerup") then
		gui.set_enabled(self.powerup_node, true)
	end

	self.druid:on_message(message_id, message, sender)
end

function final(self)    self.druid:final() end

function update(self, dt) self.druid:update(dt) end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end
