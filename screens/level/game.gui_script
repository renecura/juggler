local FULL_WIDTH = 500

local function set_progress(self, p)       -- p entre 0 y 1
	p = math.max(0, math.min(1, p))
	gui.animate(self.fill, "size.x", FULL_WIDTH * p, gui.EASING_OUTBOUNCE, 0.1)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.left  = gui.get_node("left_btn")
	self.right = gui.get_node("right_btn")

	self.fill = gui.get_node("progress_fill")
	set_progress(self, 0)
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		if gui.pick_node(self.left, action.x, action.y) then
			msg.post("/scene", "fire", { side = "left" })
		elseif gui.pick_node(self.right, action.x, action.y) then
			msg.post("/scene", "fire", { side = "right" })
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_progress") then
		set_progress(self, message.value)
	end
end

