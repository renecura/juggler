local state = require("core.state")
local powerups = require("core.powerups")

local function unload_current(self)
	if not self.current then return end
	
	local url = "#" .. self.current
	msg.post(url, "disable")
	msg.post(url, "final")
	msg.post(url, "unload")
end

local function load_screen(self, name)
	unload_current(self)
	
	self.current = name
	msg.post("#" .. name, "load")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	load_screen(self, "level")
end



function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")
		return
	end
	
	if message_id == hash("proxy_unloaded") then
		self.current = nil
		return 
	end

	if message_id == hash("level_ended") then
		unload_current(self)
		if message.won then
			-- TODO: Show powerups
			-- pick powerups
			msg.post("/ui#powerups", "show", { 
				a = "speedup_1", 
				b = "extra_ball_1" 
			})
		else
			-- TODO: show game over
			msg.post("/ui#gameover", "show", { 
				level = state.level,
				score = state.score 
			})
		end
		return 
	end

	if message_id == hash("powerup_chosen") then
		-- TODO: PowerUp Magik!
		print("Powerup chosen: ", message.powerup)
		local pwup = powerups.by_id[message.powerup]
		pwup.aplicar(state, pwup)

		-- Level UP!
		state.level = state.level + 1
		state.score_target = state.score_target * 2
		
		load_screen(self, "level")
		return
	end
	
	if message_id == hash("to_menu") then
		print("Volviendo al menu")
		state.reset()
		
		load_screen(self, "level")
		-- load_screen(self, "menu")
		return
	end

end