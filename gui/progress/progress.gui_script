local FULL_WIDTH = 500

function init(self)
	self.fill = gui.get_node("fill")
end

local function set_progress(self, p)       -- p entre 0 y 1
	p = math.max(0, math.min(1, p))
	local size = gui.get_size(self.fill)
	size.x = FULL_WIDTH * p
	gui.set_size(self.fill, size)
end

function on_message(self, message_id, message)
	if message_id == hash("set_progress") then
		set_progress(self, message.value)
	end
end