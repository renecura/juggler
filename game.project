[bootstrap]
main_collection = /game/game.collectionc

[script]
shared_state = 1

[display]
width = 720
height = 1280
high_dpi = 1

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[project]
title = Juggler
compress_archive = 1
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/refs/heads/main.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.4.0.zip
dependencies#2 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip

[physics]
debug = 0

