function init(self)
	self.volando = false
end

function on_message(self, message_id, message)
	if message_id == hash("fire") and not self.volando then
		self.volando = true
		
		go.animate(".", "position.y",
			go.PLAYBACK_ONCE_PINGPONG,
			message.alto,
			go.EASING_OUTQUAD,
			message.speed)
		
		go.animate(".", "position.x",
			go.PLAYBACK_ONCE_FORWARD,
			message.hand,
			go.EASING_OUTQUAD,
			message.speed, 0,
			function (self)
				self.volando = false
				msg.post("/scene", "landed", { ball = go.get_id(), target = message.target})
			end)
	end
end