local druid = require("druid.druid")
local powerups = require("game.powerups.powerups")

local function on_pick_a()
	print("Pick A")
end

local function on_pick_b()
	print("Pick B")
end

local function on_watch_ad()
	print("Reward Ad")
end

local function fill_card(prefix, id)
	local p = powerups.by_id[id]
	
	gui.set_text(gui.get_node(prefix .. "/title"), p.title)
	-- gui.play_flipbook(gui.get_node(prefix .. "/icon"), hash(p.icon))
end

function init(self)

	self.popup = gui.get_node("popup")       -- el nodo raíz de tu ventana
	gui.set_enabled(self.popup, false)       -- oculto al iniciar
	
	self.druid = druid.new(self)

	self.blocker = self.druid:new_blocker("blocker")

	self.btn_a  = self.druid:new_button("card_a/root", on_pick_a)
	self.btn_b  = self.druid:new_button("card_b/root", on_pick_b)
	self.btn_ad = self.druid:new_button("btn_ad", on_watch_ad)
end

function final(self)    self.druid:final() end

function update(self, dt) self.druid:update(dt) end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_powerups") then
		print("Showing powerups...")
		fill_card("card_a", message.a)
		fill_card("card_b", message.b)
		gui.set_enabled(self.popup, true)
	end
	
	self.druid:on_message(message_id, message, sender)
end
function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end